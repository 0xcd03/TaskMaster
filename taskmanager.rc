101 MENU
BEGIN
 POPUP "Process"
 BEGIN
  MENUITEM "End process / thread...",2001
  MENUITEM "Pause...",2002
  MENUITEM "Resume our pauses...",2003
  MENUITEM "Trim selected working set...",2004
  MENUITEM "Trim all eligible apps...",2005
  MENUITEM SEPARATOR
  MENUITEM "Normal priority",2006
  MENUITEM "Below normal priority",2007
  MENUITEM "Above normal priority",2008
  MENUITEM "End process tree...",2019
  MENUITEM "Pause process tree...",2020
