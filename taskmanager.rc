  MENUITEM "Services",2102
  MENUITEM "Users",2103
  MENUITEM "Performance",2104
  MENUITEM "Startup sources",2105
  MENUITEM "Persistent app history",2106
 END
 POPUP "Service"
 BEGIN
  MENUITEM "Start selected service...",2200
  MENUITEM "Stop selected service...",2201
  MENUITEM "Automatic start...",2202
  MENUITEM "Disable startup...",2203
 END
 POPUP "Startup"
 BEGIN
  MENUITEM "Disable selected entry...",2400
  MENUITEM "Enable / restore selected entry...",2401
 END
 POPUP "Settings"
 BEGIN
  MENUITEM "Russian (restart)",2300
  MENUITEM "English (restart)",2301
  MENUITEM "Tree / flat processes",2310
  MENUITEM "History storage status",2320
  MENUITEM "Light theme",2302
  MENUITEM "Dark theme",2303
  MENUITEM "Refresh: 1 second",2305
  MENUITEM "Refresh: 3 seconds",2306
 END
END
102 MENU
BEGIN
 POPUP "Процесс"
 BEGIN
  MENUITEM "Завершить процесс / поток...",2001
  MENUITEM "Приостановить...",2002
  MENUITEM "Снять наши приостановки...",2003
  MENUITEM "Сократить рабочий набор...",2004
  MENUITEM "Освободить RAM доступных приложений...",2005
  MENUITEM SEPARATOR
  MENUITEM "Обычный приоритет",2006
  MENUITEM "Приоритет ниже обычного",2007
  MENUITEM "Приоритет выше обычного",2008
  MENUITEM "Завершить дерево процессов...",2019
  MENUITEM "Приостановить дерево...",2020
  MENUITEM "Снять наши приостановки дерева...",2021
  MENUITEM "Сократить рабочие наборы дерева...",2022
  MENUITEM "Потоки выбранного процесса",2010
  MENUITEM "Вернуться к процессам",2011
  MENUITEM "Открыть расположение файла",2012
  MENUITEM "Свойства файла",2013
  MENUITEM "Создать минидамп...",2014
  MENUITEM "Лимит CPU: 20%...",2015
  MENUITEM "Снять наш лимит CPU...",2016
  MENUITEM "Привязка: один доступный CPU...",2017
  MENUITEM "Привязка: все CPU...",2018
 END
 POPUP "Разделы"
 BEGIN
  MENUITEM "Процессы",2100
  MENUITEM "Службы",2102
  MENUITEM "Пользователи",2103
  MENUITEM "Производительность",2104
  MENUITEM "Источники автозагрузки",2105
  MENUITEM "Постоянная история",2106
 END
 POPUP "Служба"
 BEGIN
  MENUITEM "Запустить службу...",2200
  MENUITEM "Остановить службу...",2201
  MENUITEM "Автоматический запуск...",2202
  MENUITEM "Отключить запуск...",2203
 END
 POPUP "Автозагрузка"
 BEGIN
  MENUITEM "Отключить выбранный элемент...",2400
  MENUITEM "Включить / восстановить элемент...",2401
 END
 POPUP "Настройки"
 BEGIN
  MENUITEM "Русский (перезапуск)",2300
  MENUITEM "English (restart)",2301
  MENUITEM "Дерево / плоский список",2310
  MENUITEM "Состояние хранилища истории",2320
  MENUITEM "Светлая тема",2302
  MENUITEM "Тёмная тема",2303
  MENUITEM "Обновление: 1 секунда",2305
  MENUITEM "Обновление: 3 секунды",2306
 END
END
