301 DIALOGEX 0,0,260,112
STYLE 0x80C800C0
CAPTION "Memory optimization"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Start when physical memory usage reaches:",-1,12,12,236,14
 EDITTEXT 3001,12,32,52,16,0x50012080
 LTEXT "% (50-95)",-1,70,34,100,14
 LTEXT "Sustained pressure for 10 seconds; at most once every 5 minutes. Active apps are skipped.",-1,12,57,236,25
 DEFPUSHBUTTON "Save",1,130,89,55,16
 PUSHBUTTON "Cancel",2,191,89,55,16
END
302 DIALOGEX 0,0,260,112
STYLE 0x80C800C0
CAPTION "Оптимизация памяти"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Запускать при занятой физической памяти:",-1,12,12,236,14
 EDITTEXT 3001,12,32,52,16,0x50012080
 LTEXT "% (50–95)",-1,70,34,100,14
 LTEXT "Превышение в течение 10 секунд; не чаще раза в 5 минут. Активные приложения пропускаются.",-1,12,57,236,25
 DEFPUSHBUTTON "Сохранить",1,130,89,55,16
 PUSHBUTTON "Отмена",2,191,89,55,16
END

